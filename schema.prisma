// LoadLink Pakistan - Prisma schema
// PostgreSQL database. Run:
//   npx prisma generate
//   npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
  MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum VehicleStatus {
  AVAILABLE
  BUSY
  OFFLINE
  SUSPENDED
}

enum LoadStatus {
  POSTED
  SEARCHING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum SpaceBookingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum SpaceListingStatus {
  OPEN
  FULL
  CANCELLED
}

enum SpaceRequestStatus {
  OPEN
  BOOKED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum TripStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  NEAR_DESTINATION
  DELIVERED
}

enum DriverVerification {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum NotificationType {
  LOAD_POSTED
  BOOKING_REQUEST
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  TRIP_STARTED
  TRIP_UPDATED
  TRIP_DELIVERED
  ACCOUNT_VERIFIED
  PAYMENT_CREATED
  PAYMENT_PAID
  PAYMENT_FAILED
  PASSWORD_RESET
  SYSTEM
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  EASYPAISA
  JAZZCASH
  CARD
}

model User {
  id           String     @id @default(uuid())
  fullName     String
  mobile       String     @unique
  email        String?    @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  city         String?
  status       UserStatus @default(ACTIVE)
  emailVerified Boolean @default(false)
  permissions   String?    @default("[]")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  driverProfile DriverProfile?
  loads         Load[]
  bookingsAsCustomer Booking[] @relation("CustomerBookings")
  notifications Notification[]
  ratingsGiven  Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")
  passwordResetTokens PasswordResetToken[]
  otpVerifications OtpVerification[]
  pushSubscriptions PushSubscription[]
  payments Payment[]
  spaceRequests SpaceRequest[]
  spaceBookingsAsCustomer SpaceBooking[] @relation("SpaceCustomerBookings")
  auditLogs AuditLog[]
}

model DriverProfile {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cnic             String
  cnicDocUrl       String?
  drivingLicense   String
  licenseDocUrl    String?
  verification     DriverVerification @default(PENDING_VERIFICATION)
  rejectionReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  cnicExpiryDate    DateTime?
  licenseExpiryDate DateTime?

  vehicles Vehicle[]
  bookingsAsDriver Booking[] @relation("DriverBookings")
  spaceListings SpaceListing[]
  spaceBookingsAsDriver SpaceBooking[] @relation("SpaceDriverBookings")
  trips    Trip[]
}

model Vehicle {
  id            String        @id @default(uuid())
  driverId      String
  driver        DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleType   String
  vehicleNumber String        @unique
  capacityKg    Int
  brand         String?
  model         String?
  year          Int?
  documentUrl   String?
  documentExpiryDate DateTime?
  status        VehicleStatus @default(OFFLINE)
  isVerified    Boolean       @default(false)
  latitude      Float?
  longitude     Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bookings Booking[]
  spaceListings SpaceListing[] @relation("VehicleSpaceListings")
  spaceBookings SpaceBooking[]
  trips    Trip[]
}

model Load {
  id                    String     @id @default(uuid())
  customerId            String
  customer              User       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  pickupAddress         String
  pickupLatitude        Float?
  pickupLongitude       Float?

  destinationAddress    String
  destinationLatitude   Float?
  destinationLongitude  Float?

  description           String
  weightKg               Float
  preferredVehicle       String?
  status                 LoadStatus @default(POSTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  trips    Trip[]
}

model Booking {
  id         String        @id @default(uuid())
  loadId     String
  load       Load          @relation(fields: [loadId], references: [id], onDelete: Cascade)
  customerId String
  customer   User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  driverId   String
  driver     DriverProfile @relation("DriverBookings", fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  status     BookingStatus @default(REQUESTED)
  agreedFare Float?
  platformFee Float?
  driverPayout Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip?
}


model SpaceListing {
  id                    String            @id @default(uuid())
  driverId              String
  driver                DriverProfile     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId             String
  vehicle               Vehicle           @relation("VehicleSpaceListings", fields: [vehicleId], references: [id], onDelete: Cascade)
  fromLocation          String
  toLocation            String
  travelDate            DateTime
  totalCapacityKg       Float
  availableWeightKg     Float
  cargoType             String?
  expectedCharges       Float?
  exactPickupAddress    String?
  exactPickupLatitude   Float?
  exactPickupLongitude  Float?
  status                SpaceListingStatus @default(OPEN)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  bookings              SpaceBooking[]

  @@index([fromLocation, toLocation, travelDate, status])
}

model SpaceRequest {
  id                    String            @id @default(uuid())
  customerId            String
  customer              User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pickupLocation        String
  destination           String
  travelDate            DateTime
  cargoWeightKg         Float
  cargoType             String?
  vehicleRequirement    String?
  expectedBudget        Float?
  description           String?
  status                SpaceRequestStatus @default(OPEN)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  bookings              SpaceBooking[]

  @@index([pickupLocation, destination, travelDate, status])
}

model SpaceBooking {
  id                    String            @id @default(uuid())
  spaceListingId        String
  spaceListing          SpaceListing      @relation(fields: [spaceListingId], references: [id], onDelete: Cascade)
  spaceRequestId        String
  spaceRequest          SpaceRequest      @relation(fields: [spaceRequestId], references: [id], onDelete: Cascade)
  customerId            String
  customer              User              @relation("SpaceCustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  driverId              String
  driver                DriverProfile     @relation("SpaceDriverBookings", fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId             String
  vehicle               Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookedWeightKg        Float
  agreedFare            Float?
  exactPickupUnlocked   Boolean           @default(false)
  status                SpaceBookingStatus @default(REQUESTED)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([spaceListingId, status])
  @@index([spaceRequestId, status])
}

model Trip {
  id          String        @id @default(uuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  loadId      String
  load        Load          @relation(fields: [loadId], references: [id], onDelete: Cascade)
  driverId    String
  driver      DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId   String
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  pickup          String
  destination     String
  currentLatitude  Float?
  currentLongitude Float?
  status          TripStatus @default(ASSIGNED)

  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())

  ratings Rating[]
  payments Payment[]
}

model Rating {
  id         String   @id @default(uuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("RatingsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("RatingsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([tripId, fromUserId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}


model Payment {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId      String?
  trip        Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  amount      Float
  currency    String        @default("PKR")
  method      PaymentMethod
  provider    String?
  providerReference String?
  status      PaymentStatus @default(PENDING)
  metadata    String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, status])
  @@index([providerReference])
}

model OtpVerification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String   @default("SIGNUP")
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, purpose, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  ip        String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
