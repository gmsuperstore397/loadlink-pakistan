PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/loadlink
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=*
BASE_FARE=500
PER_KM_RATE=45
PLATFORM_COMMISSION_RATE=0.10
GEOCODING_API_KEY=
ADMIN_MOBILE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Persistent document storage. On Render, mount a persistent disk and set this
# to its mount path, e.g. /var/data/loadlink-uploads
# Local development can leave this empty to use ./uploads.
UPLOADS_DIR=

PUBLIC_APP_URL=http://localhost:5000
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
NOTIFY_SMS=false
NOTIFY_WHATSAPP=false
VAPID_SUBJECT=mailto:admin@loadlink.pk
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
EASYPAISA_CHECKOUT_URL=
JAZZCASH_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=

# Email OTP (Resend or another email provider)
# Gmail SMTP can be added later; never use a normal Gmail password here.
EMAIL_OTP_ENABLED=true

GMAIL_USER=
GMAIL_APP_PASSWORD=
